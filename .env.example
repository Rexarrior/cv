# Telemetry stats token — set this to a strong random string in production.
# Without it the /api/stats and /api/dashboard endpoints are disabled.
STATS_TOKEN=replace-with-a-long-random-secret

# Salt for hashing visitor IPs. Use a long random string.
IP_SALT=replace-with-a-different-long-random-secret

# Maximum number of simultaneous LaTeX compilations.
PDF_CONCURRENCY=2
